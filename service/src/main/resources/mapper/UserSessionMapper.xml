<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fyreader.service.mapper.UserSessionMapper">

    <sql id="Base_Column_List">
        token, user_id, expire_time, create_time
    </sql>

    <insert id="insert" parameterType="com.fyreader.service.entity.UserSession">
        INSERT INTO t_user_session (token, user_id, expire_time, create_time)
        VALUES (#{token}, #{userId}, #{expireTime}, CURRENT_TIMESTAMP)
    </insert>

    <select id="selectByToken" resultType="com.fyreader.service.entity.UserSession">
        SELECT <include refid="Base_Column_List"/>
        FROM t_user_session
        WHERE token = #{token}
    </select>

    <delete id="deleteByToken">
        DELETE FROM t_user_session WHERE token = #{token}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM t_user_session WHERE user_id = #{userId}
    </delete>

    <delete id="deleteExpired">
        DELETE FROM t_user_session WHERE expire_time &lt; #{now}
    </delete>

</mapper>

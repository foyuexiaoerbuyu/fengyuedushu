<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fyreader.service.mapper.BookGroupMapper">

    <select id="selectAll" resultType="com.fyreader.service.entity.BookGroup">
        SELECT id, group_name, sort_no, remark, create_time
        FROM t_book_group
        ORDER BY sort_no ASC
    </select>

</mapper>
